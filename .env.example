STORE_PUBLIC_URL=https://store.onetimelabs.net

# Browser-safe Supabase Auth values
VITE_SUPABASE_URL=https://vzbopyksyfognxfubncf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Store administration
# Comma-separated Store login emails allowed to use /admin.
STORE_ADMIN_EMAILS=your-email@example.com

# Stripe mode. Production = live. Preview/development = test.
STRIPE_MODE=live

# Stripe server values. The key MUST match STRIPE_MODE.
# Product/Price IDs for BOTH modes are stored per product in Supabase.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Server-only Supabase values
SUPABASE_URL=https://vzbopyksyfognxfubncf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
LICENSING_ACTIVATE_URL=https://vzbopyksyfognxfubncf.supabase.co/functions/v1/activate-license
LICENSING_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Cloudflare R2 credentials.
# Bucket + object path are stored per product in Supabase.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Store support/contact email
RESEND_API_KEY=re_REPLACE_ME
# Optional sender override:
# SUPPORT_FROM_EMAIL=OneTime Labs Support <support@onetimelabs.net>
