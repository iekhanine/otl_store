STORE_PUBLIC_URL=https://store.onetimelabs.net
VITE_STREAMSAFE_DISPLAY_PRICE=$49.00

# Browser-safe Supabase Auth values
VITE_SUPABASE_URL=https://vzbopyksyfognxfubncf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Store administration
# Comma-separated Store login emails allowed to use /admin.
STORE_ADMIN_EMAILS=your-email@example.com

# Stripe server values - production Store should use LIVE values.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_STREAMSAFE_PRICE_ID=price_REPLACE_WITH_LIVE_PRICE
STRIPE_REQUIRE_LIVE_MODE=true

# Stripe Connect - added in the next marketplace step.
# No Connect secret values are required for Store v2.0 yet.

# Server-only Supabase values
SUPABASE_URL=https://vzbopyksyfognxfubncf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
LICENSING_ACTIVATE_URL=https://vzbopyksyfognxfubncf.supabase.co/functions/v1/activate-license
LICENSING_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Legacy StreamSafe installer storage.
# StreamSafe will move to Cloudflare R2 before launch because the
# Supabase Free file-size limit cannot hold the current installer.
STREAMSAFE_STORAGE_BUCKET=software-releases
STREAMSAFE_STORAGE_PATH=streamsafe/StreamSafeSetup.exe
STREAMSAFE_CURRENT_VERSION=0.12.10

# Store support/contact email
# Reuses the OneTime Labs / ivankay.org Resend setup.
# The API defaults to: OneTime Labs <inquiry@onetimelabs.net>
RESEND_API_KEY=re_REPLACE_ME
# Optional sender override:
# SUPPORT_FROM_EMAIL=OneTime Labs Support <support@onetimelabs.net>

# Cloudflare R2 - to be wired after marketplace foundation is deployed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=onetimelabs-releases
